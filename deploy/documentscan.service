[Unit]
Description=DocumentScan: ScanSnap S1300 button to PDF
Documentation=https://github.com/fardage/DocumentScan

[Service]
Type=simple
User=documentscan
Group=documentscan
# The libsane udev rule gives scanner USB nodes to this group.
SupplementaryGroups=scanner
WorkingDirectory=/opt/documentscan
Environment=PYTHONPATH=/opt/documentscan PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
# Our own dll.conf/epjitsu.conf (epjitsu only, firmware under /opt/documentscan).
Environment=SANE_CONFIG_DIR=/opt/documentscan/sane
Environment=OUTPUT_DIR=/var/lib/documentscan/outbox SPOOL_DIR=/var/lib/documentscan/spool
EnvironmentFile=-/etc/documentscan.env
ExecStart=/usr/bin/python3 -m documentscan.daemon
Restart=always
RestartSec=5
StateDirectory=documentscan documentscan/outbox documentscan/spool
StateDirectoryMode=0750

# One page in flight needs roughly 200 MB at 300 dpi colour; above that the
# kernel reclaims (zram) instead of letting the scan take down the Pi.
MemoryHigh=280M
MemoryMax=350M

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Netlink for libusb hotplug; INET for delivering to paperless.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
DevicePolicy=closed
DeviceAllow=char-usb_device rw

[Install]
WantedBy=multi-user.target
