# Overrides for the documentscan service; see the README for all variables.
# Installed once as /etc/documentscan.env and never overwritten by install.sh.
# After editing: sudo systemctl restart documentscan documentscan-upload

# Upload to paperless-ngx (API token from your paperless profile)
#PAPERLESS_URL=https://paperless.example:8000
#PAPERLESS_TOKEN=

#SCAN_SOURCE=ADF Duplex
#SCAN_MODE=Color
#SCAN_RESOLUTION=300
#LOG_LEVEL=INFO
